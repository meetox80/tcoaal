#pragma once
#include <cstddef>
#include <new>
#include <type_traits>
#include <utility>

namespace std {

template <class T>
struct default_delete {
    constexpr default_delete() noexcept = default;
    template <class U, class = typename enable_if<is_convertible<U*, T*>::value>::type>
    default_delete(const default_delete<U>&) noexcept {}
    void operator()(T* p) const noexcept { delete p; }
};

template <class T>
struct default_delete<T[]> {
    void operator()(T* p) const noexcept { delete[] p; }
};

template <class T, class D = default_delete<T>>
class unique_ptr {
public:
    using pointer = T*;
    using element_type = T;

    constexpr unique_ptr() noexcept = default;
    constexpr unique_ptr(nullptr_t) noexcept {}
    explicit unique_ptr(T* p) noexcept : p_(p) {}
    unique_ptr(unique_ptr&& o) noexcept : p_(o.release()) {}
    template <class U, class E, class = typename enable_if<is_convertible<U*, T*>::value>::type>
    unique_ptr(unique_ptr<U, E>&& o) noexcept : p_(o.release()) {}
    unique_ptr(const unique_ptr&) = delete;
    ~unique_ptr() { reset(); }

    unique_ptr& operator=(unique_ptr&& o) noexcept {
        reset(o.release());
        return *this;
    }
    template <class U, class E, class = typename enable_if<is_convertible<U*, T*>::value>::type>
    unique_ptr& operator=(unique_ptr<U, E>&& o) noexcept {
        reset(o.release());
        return *this;
    }
    unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }
    unique_ptr& operator=(const unique_ptr&) = delete;

    T* get() const noexcept { return p_; }
    T* operator->() const noexcept { return p_; }
    T& operator*() const noexcept { return *p_; }
    explicit operator bool() const noexcept { return p_ != nullptr; }
    T* release() noexcept {
        T* p = p_;
        p_ = nullptr;
        return p;
    }
    void reset(T* p = nullptr) noexcept {
        T* old = p_;
        p_ = p;
        if (old) D()(old);
    }
    void swap(unique_ptr& o) noexcept { std::swap(p_, o.p_); }

private:
    T* p_ = nullptr;
};

template <class T, class D>
class unique_ptr<T[], D> {
public:
    constexpr unique_ptr() noexcept = default;
    constexpr unique_ptr(nullptr_t) noexcept {}
    explicit unique_ptr(T* p) noexcept : p_(p) {}
    unique_ptr(unique_ptr&& o) noexcept : p_(o.release()) {}
    unique_ptr(const unique_ptr&) = delete;
    ~unique_ptr() { reset(); }

    unique_ptr& operator=(unique_ptr&& o) noexcept {
        reset(o.release());
        return *this;
    }
    unique_ptr& operator=(const unique_ptr&) = delete;

    T* get() const noexcept { return p_; }
    T& operator[](size_t i) const noexcept { return p_[i]; }
    explicit operator bool() const noexcept { return p_ != nullptr; }
    T* release() noexcept {
        T* p = p_;
        p_ = nullptr;
        return p;
    }
    void reset(T* p = nullptr) noexcept {
        T* old = p_;
        p_ = p;
        if (old) D()(old);
    }

private:
    T* p_ = nullptr;
};

template <class T, class D>
bool operator==(const unique_ptr<T, D>& a, nullptr_t) noexcept {
    return !a;
}
template <class T, class D>
bool operator!=(const unique_ptr<T, D>& a, nullptr_t) noexcept {
    return static_cast<bool>(a);
}
template <class T, class D, class U, class E>
bool operator==(const unique_ptr<T, D>& a, const unique_ptr<U, E>& b) noexcept {
    return a.get() == b.get();
}

template <class T, class... A>
typename enable_if<!is_array<T>::value, unique_ptr<T>>::type make_unique(A&&... a) {
    return unique_ptr<T>(new T(std::forward<A>(a)...));
}

struct __shared_count {
    long uses = 1;
    long weaks = 1;
    virtual ~__shared_count() = default;
    virtual void dispose() noexcept = 0;
    void release_use() noexcept {
        if (--uses) return;
        dispose();
        release_weak();
    }
    void release_weak() noexcept {
        if (!--weaks) delete this;
    }
};

template <class T>
struct __shared_owner final : __shared_count {
    T* p;
    explicit __shared_owner(T* q) noexcept : p(q) {}
    void dispose() noexcept override { delete p; }
};

template <class T>
struct __shared_inplace final : __shared_count {
    alignas(T) unsigned char storage[sizeof(T)];
    T* get() noexcept { return reinterpret_cast<T*>(storage); }
    void dispose() noexcept override { get()->~T(); }
};

template <class T>
class weak_ptr;

template <class T>
class shared_ptr {
public:
    using element_type = T;

    constexpr shared_ptr() noexcept = default;
    constexpr shared_ptr(nullptr_t) noexcept {}
    template <class U, class = typename enable_if<is_convertible<U*, T*>::value>::type>
    explicit shared_ptr(U* p) : p_(p), c_(p ? new __shared_owner<U>(p) : nullptr) {}
    shared_ptr(const shared_ptr& o) noexcept : p_(o.p_), c_(o.c_) { retain(); }
    shared_ptr(shared_ptr&& o) noexcept : p_(o.p_), c_(o.c_) {
        o.p_ = nullptr;
        o.c_ = nullptr;
    }
    template <class U, class = typename enable_if<is_convertible<U*, T*>::value>::type>
    shared_ptr(const shared_ptr<U>& o) noexcept : p_(o.p_), c_(o.c_) {
        retain();
    }
    template <class U, class = typename enable_if<is_convertible<U*, T*>::value>::type>
    shared_ptr(shared_ptr<U>&& o) noexcept : p_(o.p_), c_(o.c_) {
        o.p_ = nullptr;
        o.c_ = nullptr;
    }
    template <class U, class D>
    shared_ptr(unique_ptr<U, D>&& o) : shared_ptr(o.release()) {}
    ~shared_ptr() {
        if (c_) c_->release_use();
    }

    shared_ptr& operator=(const shared_ptr& o) noexcept {
        shared_ptr(o).swap(*this);
        return *this;
    }
    shared_ptr& operator=(shared_ptr&& o) noexcept {
        shared_ptr(std::move(o)).swap(*this);
        return *this;
    }
    template <class U>
    shared_ptr& operator=(const shared_ptr<U>& o) noexcept {
        shared_ptr(o).swap(*this);
        return *this;
    }
    template <class U>
    shared_ptr& operator=(shared_ptr<U>&& o) noexcept {
        shared_ptr(std::move(o)).swap(*this);
        return *this;
    }
    shared_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    T* get() const noexcept { return p_; }
    T* operator->() const noexcept { return p_; }
    T& operator*() const noexcept { return *p_; }
    explicit operator bool() const noexcept { return p_ != nullptr; }
    long use_count() const noexcept { return c_ ? c_->uses : 0; }
    void reset() noexcept { shared_ptr().swap(*this); }
    template <class U>
    void reset(U* p) {
        shared_ptr(p).swap(*this);
    }
    void swap(shared_ptr& o) noexcept {
        std::swap(p_, o.p_);
        std::swap(c_, o.c_);
    }

private:
    template <class U>
    friend class shared_ptr;
    template <class U>
    friend class weak_ptr;
    template <class U, class... A>
    friend shared_ptr<U> make_shared(A&&... a);

    T* p_ = nullptr;
    __shared_count* c_ = nullptr;

    shared_ptr(T* p, __shared_count* c) noexcept : p_(p), c_(c) {}
    void retain() noexcept {
        if (c_) c_->uses++;
    }
};

template <class T, class U>
bool operator==(const shared_ptr<T>& a, const shared_ptr<U>& b) noexcept {
    return a.get() == b.get();
}
template <class T, class U>
bool operator!=(const shared_ptr<T>& a, const shared_ptr<U>& b) noexcept {
    return a.get() != b.get();
}
template <class T>
bool operator==(const shared_ptr<T>& a, nullptr_t) noexcept {
    return !a;
}
template <class T>
bool operator!=(const shared_ptr<T>& a, nullptr_t) noexcept {
    return static_cast<bool>(a);
}
template <class T, class U>
bool operator<(const shared_ptr<T>& a, const shared_ptr<U>& b) noexcept {
    return a.get() < b.get();
}

template <class T, class... A>
shared_ptr<T> make_shared(A&&... a) {
    auto* c = new __shared_inplace<T>();
    new (c->storage) T(std::forward<A>(a)...);
    return shared_ptr<T>(c->get(), c);
}

template <class T>
class weak_ptr {
public:
    constexpr weak_ptr() noexcept = default;
    weak_ptr(const weak_ptr& o) noexcept : p_(o.p_), c_(o.c_) { retain(); }
    template <class U, class = typename enable_if<is_convertible<U*, T*>::value>::type>
    weak_ptr(const shared_ptr<U>& s) noexcept : p_(s.p_), c_(s.c_) {
        retain();
    }
    ~weak_ptr() {
        if (c_) c_->release_weak();
    }

    weak_ptr& operator=(const weak_ptr& o) noexcept {
        weak_ptr(o).swap(*this);
        return *this;
    }
    template <class U>
    weak_ptr& operator=(const shared_ptr<U>& s) noexcept {
        weak_ptr(s).swap(*this);
        return *this;
    }

    bool expired() const noexcept { return !c_ || !c_->uses; }
    shared_ptr<T> lock() const noexcept {
        if (expired()) return shared_ptr<T>();
        c_->uses++;
        return shared_ptr<T>(p_, c_);
    }
    void reset() noexcept { weak_ptr().swap(*this); }
    void swap(weak_ptr& o) noexcept {
        std::swap(p_, o.p_);
        std::swap(c_, o.c_);
    }

private:
    T* p_ = nullptr;
    __shared_count* c_ = nullptr;

    void retain() noexcept {
        if (c_) c_->weaks++;
    }
};

}
