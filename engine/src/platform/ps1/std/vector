#pragma once
#include <cstddef>
#include <initializer_list>
#include <new>
#include <type_traits>
#include <utility>

namespace std {

template <class T>
class vector {
public:
    using value_type = T;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using reference = T&;
    using const_reference = const T&;
    using pointer = T*;
    using const_pointer = const T*;
    using iterator = T*;
    using const_iterator = const T*;

    vector() noexcept = default;
    explicit vector(size_type n) { resize(n); }
    vector(size_type n, const T& v) { assign(n, v); }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type>
    vector(It first, It last) {
        assign(first, last);
    }
    vector(initializer_list<T> l) { assign(l.begin(), l.end()); }
    vector(const vector& o) {
        reserve(o.n_);
        for (size_type i = 0; i < o.n_; i++) new (p_ + i) T(o.p_[i]);
        n_ = o.n_;
    }
    vector(vector&& o) noexcept : p_(o.p_), n_(o.n_), cap_(o.cap_) { o.forget(); }
    ~vector() { dispose(); }

    vector& operator=(const vector& o) {
        if (this != &o) {
            vector t(o);
            swap(t);
        }
        return *this;
    }
    vector& operator=(vector&& o) noexcept {
        if (this != &o) {
            dispose();
            p_ = o.p_;
            n_ = o.n_;
            cap_ = o.cap_;
            o.forget();
        }
        return *this;
    }
    vector& operator=(initializer_list<T> l) {
        assign(l.begin(), l.end());
        return *this;
    }

    void assign(size_type n, const T& v) {
        T copy(v);
        clear();
        reserve(n);
        while (n_ < n) new (p_ + n_++) T(copy);
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type>
    void assign(It first, It last) {
        clear();
        for (; first != last; ++first) emplace_back(*first);
    }

    size_type size() const noexcept { return n_; }
    size_type capacity() const noexcept { return cap_; }
    bool empty() const noexcept { return n_ == 0; }
    T* data() noexcept { return p_; }
    const T* data() const noexcept { return p_; }
    T& operator[](size_type i) noexcept { return p_[i]; }
    const T& operator[](size_type i) const noexcept { return p_[i]; }
    T& at(size_type i) noexcept { return p_[i]; }
    const T& at(size_type i) const noexcept { return p_[i]; }
    T& front() noexcept { return p_[0]; }
    const T& front() const noexcept { return p_[0]; }
    T& back() noexcept { return p_[n_ - 1]; }
    const T& back() const noexcept { return p_[n_ - 1]; }
    iterator begin() noexcept { return p_; }
    iterator end() noexcept { return p_ + n_; }
    const_iterator begin() const noexcept { return p_; }
    const_iterator end() const noexcept { return p_ + n_; }
    const_iterator cbegin() const noexcept { return p_; }
    const_iterator cend() const noexcept { return p_ + n_; }

    void reserve(size_type cap) {
        if (cap > cap_) relocate(cap);
    }
    void resize(size_type n) {
        if (n < n_) shrink(n);
        reserve(n);
        while (n_ < n) new (p_ + n_++) T();
    }
    void resize(size_type n, const T& v) {
        if (n < n_) shrink(n);
        if (n > cap_) {
            T copy(v);
            reserve(n);
            while (n_ < n) new (p_ + n_++) T(copy);
        }
        while (n_ < n) new (p_ + n_++) T(v);
    }
    void clear() noexcept { shrink(0); }
    void shrink_to_fit() {
        if (cap_ > n_) relocate(n_);
    }

    void push_back(const T& v) { emplace_back(v); }
    void push_back(T&& v) { emplace_back(std::move(v)); }
    template <class... A>
    T& emplace_back(A&&... a) {
        if (n_ < cap_) {
            new (p_ + n_) T(std::forward<A>(a)...);
        } else {
            size_type cap = grown(n_ + 1);
            T* q = allocate(cap);
            new (q + n_) T(std::forward<A>(a)...);
            move_into(q);
            ::operator delete(p_);
            p_ = q;
            cap_ = cap;
        }
        return p_[n_++];
    }
    void pop_back() noexcept { p_[--n_].~T(); }

    template <class... A>
    iterator emplace(const_iterator at, A&&... a) {
        size_type i = static_cast<size_type>(at - p_);
        if (i == n_) {
            emplace_back(std::forward<A>(a)...);
            return p_ + i;
        }
        T v(std::forward<A>(a)...);
        if (n_ == cap_) relocate(grown(n_ + 1));
        new (p_ + n_) T(std::move(p_[n_ - 1]));
        for (size_type k = n_ - 1; k > i; k--) p_[k] = std::move(p_[k - 1]);
        p_[i] = std::move(v);
        n_++;
        return p_ + i;
    }
    iterator insert(const_iterator at, const T& v) { return emplace(at, v); }
    iterator insert(const_iterator at, T&& v) { return emplace(at, std::move(v)); }
    iterator insert(const_iterator at, size_type n, const T& v) {
        vector t(n, v);
        return insert_moved(at, t);
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type>
    iterator insert(const_iterator at, It first, It last) {
        vector t(first, last);
        return insert_moved(at, t);
    }
    iterator insert(const_iterator at, initializer_list<T> l) { return insert(at, l.begin(), l.end()); }

    iterator erase(const_iterator at) { return erase(at, at + 1); }
    iterator erase(const_iterator first, const_iterator last) {
        size_type i = static_cast<size_type>(first - p_), k = static_cast<size_type>(last - first);
        if (!k) return p_ + i;
        for (size_type j = i; j + k < n_; j++) p_[j] = std::move(p_[j + k]);
        shrink(n_ - k);
        return p_ + i;
    }

    void swap(vector& o) noexcept {
        std::swap(p_, o.p_);
        std::swap(n_, o.n_);
        std::swap(cap_, o.cap_);
    }

private:
    T* p_ = nullptr;
    size_type n_ = 0;
    size_type cap_ = 0;

    static T* allocate(size_type cap) { return static_cast<T*>(::operator new(cap * sizeof(T))); }
    size_type grown(size_type need) const noexcept {
        size_type cap = cap_ ? cap_ + cap_ / 2 + 1 : 4;
        return cap < need ? need : cap;
    }
    void forget() noexcept {
        p_ = nullptr;
        n_ = cap_ = 0;
    }
    void dispose() noexcept {
        shrink(0);
        ::operator delete(p_);
    }
    void shrink(size_type n) noexcept {
        while (n_ > n) p_[--n_].~T();
    }
    void move_into(T* q) noexcept {
        for (size_type i = 0; i < n_; i++) {
            new (q + i) T(std::move(p_[i]));
            p_[i].~T();
        }
    }
    void relocate(size_type cap) {
        T* q = allocate(cap);
        move_into(q);
        ::operator delete(p_);
        p_ = q;
        cap_ = cap;
    }
    iterator insert_moved(const_iterator at, vector& t) {
        size_type i = static_cast<size_type>(at - p_), k = t.n_;
        if (!k) return p_ + i;
        if (n_ + k > cap_) relocate(grown(n_ + k));
        for (size_type j = n_; j-- > i;) {
            if (j + k >= n_) new (p_ + j + k) T(std::move(p_[j]));
            else p_[j + k] = std::move(p_[j]);
        }
        for (size_type j = 0; j < k; j++) {
            if (i + j < n_) p_[i + j] = std::move(t.p_[j]);
            else new (p_ + i + j) T(std::move(t.p_[j]));
        }
        n_ += k;
        return p_ + i;
    }
};

template <class T>
bool operator==(const vector<T>& a, const vector<T>& b) {
    if (a.size() != b.size()) return false;
    for (size_t i = 0; i < a.size(); i++) {
        if (!(a[i] == b[i])) return false;
    }
    return true;
}

template <class T>
bool operator!=(const vector<T>& a, const vector<T>& b) {
    return !(a == b);
}

}
