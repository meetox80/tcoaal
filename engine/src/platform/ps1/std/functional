#pragma once
#include <cstddef>
#include <type_traits>
#include <utility>

namespace std {

template <class>
class function;

template <class R, class... A>
class function<R(A...)> {
    struct callable {
        virtual ~callable() = default;
        virtual R call(A... a) = 0;
        virtual callable* clone() const = 0;
    };

    template <class F>
    struct holder final : callable {
        F f;
        template <class G>
        explicit holder(G&& g) : f(std::forward<G>(g)) {}
        R call(A... a) override { return f(std::forward<A>(a)...); }
        callable* clone() const override { return new holder(f); }
    };

    callable* c_ = nullptr;

public:
    function() noexcept = default;
    function(nullptr_t) noexcept {}
    template <class F, class = typename enable_if<!is_same<typename decay<F>::type, function>::value>::type>
    function(F&& f) : c_(new holder<typename decay<F>::type>(std::forward<F>(f))) {}
    function(const function& o) : c_(o.c_ ? o.c_->clone() : nullptr) {}
    function(function&& o) noexcept : c_(o.c_) { o.c_ = nullptr; }
    ~function() { delete c_; }

    function& operator=(const function& o) {
        if (this != &o) {
            callable* n = o.c_ ? o.c_->clone() : nullptr;
            delete c_;
            c_ = n;
        }
        return *this;
    }

    function& operator=(function&& o) noexcept {
        if (this != &o) {
            delete c_;
            c_ = o.c_;
            o.c_ = nullptr;
        }
        return *this;
    }

    function& operator=(nullptr_t) noexcept {
        delete c_;
        c_ = nullptr;
        return *this;
    }

    template <class F, class = typename enable_if<!is_same<typename decay<F>::type, function>::value>::type>
    function& operator=(F&& f) {
        return *this = function(std::forward<F>(f));
    }

    explicit operator bool() const noexcept { return c_ != nullptr; }
    R operator()(A... a) const { return c_->call(std::forward<A>(a)...); }
};

}
