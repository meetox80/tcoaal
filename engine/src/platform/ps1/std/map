#pragma once
#include <cstddef>
#include <initializer_list>
#include <utility>
#include <vector>

namespace std {

template <class Key, class Node, class Cmp, Key const& (*KeyOf)(const Node&)>
class __sorted_nodes {
public:
    using size_type = size_t;

    template <class N>
    class basic_iterator {
    public:
        using value_type = N;
        using difference_type = ptrdiff_t;
        using pointer = N*;
        using reference = N&;

        basic_iterator() noexcept = default;
        explicit basic_iterator(Node* const* at) noexcept : at_(at) {}
        template <class M, class = typename enable_if<is_const<N>::value && !is_const<M>::value>::type>
        basic_iterator(const basic_iterator<M>& o) noexcept : at_(o.slot()) {}

        N& operator*() const noexcept { return **at_; }
        N* operator->() const noexcept { return *at_; }
        basic_iterator& operator++() noexcept {
            ++at_;
            return *this;
        }
        basic_iterator operator++(int) noexcept {
            basic_iterator t = *this;
            ++at_;
            return t;
        }
        basic_iterator& operator--() noexcept {
            --at_;
            return *this;
        }
        basic_iterator operator--(int) noexcept {
            basic_iterator t = *this;
            --at_;
            return t;
        }
        template <class M>
        bool operator==(const basic_iterator<M>& o) const noexcept {
            return at_ == o.slot();
        }
        template <class M>
        bool operator!=(const basic_iterator<M>& o) const noexcept {
            return at_ != o.slot();
        }
        Node* const* slot() const noexcept { return at_; }

    private:
        Node* const* at_ = nullptr;
    };

    using iterator = basic_iterator<Node>;
    using const_iterator = basic_iterator<const Node>;

    __sorted_nodes() = default;
    __sorted_nodes(const __sorted_nodes& o) : cmp_(o.cmp_) {
        nodes_.reserve(o.nodes_.size());
        for (Node* n : o.nodes_) nodes_.push_back(new Node(*n));
    }
    __sorted_nodes(__sorted_nodes&& o) noexcept : nodes_(std::move(o.nodes_)), cmp_(o.cmp_) {}
    ~__sorted_nodes() { clear(); }

    __sorted_nodes& operator=(const __sorted_nodes& o) {
        if (this != &o) {
            __sorted_nodes t(o);
            swap(t);
        }
        return *this;
    }
    __sorted_nodes& operator=(__sorted_nodes&& o) noexcept {
        if (this != &o) {
            clear();
            nodes_ = std::move(o.nodes_);
        }
        return *this;
    }

    size_type size() const noexcept { return nodes_.size(); }
    bool empty() const noexcept { return nodes_.empty(); }
    iterator begin() noexcept { return iterator(nodes_.data()); }
    iterator end() noexcept { return iterator(nodes_.data() + nodes_.size()); }
    const_iterator begin() const noexcept { return const_iterator(nodes_.data()); }
    const_iterator end() const noexcept { return const_iterator(nodes_.data() + nodes_.size()); }
    const_iterator cbegin() const noexcept { return begin(); }
    const_iterator cend() const noexcept { return end(); }

    void clear() noexcept {
        for (Node* n : nodes_) delete n;
        nodes_.clear();
    }

    iterator find(const Key& k) noexcept {
        size_type i = lower(k);
        return i < nodes_.size() && !cmp_(k, KeyOf(*nodes_[i])) ? nth(i) : end();
    }
    const_iterator find(const Key& k) const noexcept {
        size_type i = lower(k);
        return i < nodes_.size() && !cmp_(k, KeyOf(*nodes_[i])) ? const_iterator(nodes_.data() + i) : end();
    }
    size_type count(const Key& k) const noexcept { return find(k) != end(); }
    bool contains(const Key& k) const noexcept { return find(k) != end(); }
    iterator lower_bound(const Key& k) noexcept { return nth(lower(k)); }
    const_iterator lower_bound(const Key& k) const noexcept { return const_iterator(nodes_.data() + lower(k)); }
    iterator upper_bound(const Key& k) noexcept {
        size_type i = lower(k);
        if (i < nodes_.size() && !cmp_(k, KeyOf(*nodes_[i]))) i++;
        return nth(i);
    }

    template <class... A>
    pair<iterator, bool> emplace(A&&... a) {
        Node* n = new Node(std::forward<A>(a)...);
        size_type i = lower(KeyOf(*n));
        if (i < nodes_.size() && !cmp_(KeyOf(*n), KeyOf(*nodes_[i]))) {
            delete n;
            return {nth(i), false};
        }
        nodes_.insert(nodes_.begin() + i, n);
        return {nth(i), true};
    }
    pair<iterator, bool> insert(const Node& v) { return emplace(v); }
    pair<iterator, bool> insert(Node&& v) { return emplace(std::move(v)); }
    template <class It>
    void insert(It first, It last) {
        for (; first != last; ++first) emplace(*first);
    }

    iterator erase(const_iterator it) {
        size_type i = static_cast<size_type>(it.slot() - nodes_.data());
        delete nodes_[i];
        nodes_.erase(nodes_.begin() + i);
        return nth(i);
    }
    iterator erase(iterator it) { return erase(const_iterator(it)); }
    size_type erase(const Key& k) {
        const_iterator it = find(k);
        if (it == end()) return 0;
        erase(it);
        return 1;
    }

    void swap(__sorted_nodes& o) noexcept { nodes_.swap(o.nodes_); }

protected:
    vector<Node*> nodes_;
    Cmp cmp_;

    iterator nth(size_type i) noexcept { return iterator(nodes_.data() + i); }
    size_type lower(const Key& k) const noexcept {
        size_type lo = 0, hi = nodes_.size();
        while (lo < hi) {
            size_type mid = (lo + hi) / 2;
            if (cmp_(KeyOf(*nodes_[mid]), k)) lo = mid + 1;
            else hi = mid;
        }
        return lo;
    }
    size_type slot_for(const Key& k) noexcept { return lower(k); }
    bool hit(size_type i, const Key& k) const noexcept { return i < nodes_.size() && !cmp_(k, KeyOf(*nodes_[i])); }
};

template <class K, class V>
const K& __map_key(const pair<const K, V>& p) {
    return p.first;
}

template <class K, class V, class Cmp = less<K>>
class map : public __sorted_nodes<K, pair<const K, V>, Cmp, &__map_key<K, V>> {
    using base = __sorted_nodes<K, pair<const K, V>, Cmp, &__map_key<K, V>>;

public:
    using key_type = K;
    using mapped_type = V;
    using value_type = pair<const K, V>;
    using typename base::const_iterator;
    using typename base::iterator;

    map() = default;
    map(initializer_list<value_type> l) {
        for (const value_type& v : l) this->emplace(v);
    }

    V& operator[](const K& k) {
        size_t i = this->slot_for(k);
        if (!this->hit(i, k)) this->nodes_.insert(this->nodes_.begin() + i, new value_type(k, V()));
        return this->nodes_[i]->second;
    }
    V& operator[](K&& k) {
        size_t i = this->slot_for(k);
        if (!this->hit(i, k)) this->nodes_.insert(this->nodes_.begin() + i, new value_type(std::move(k), V()));
        return this->nodes_[i]->second;
    }
    V& at(const K& k) { return this->find(k)->second; }
    const V& at(const K& k) const { return this->find(k)->second; }
    template <class M>
    pair<iterator, bool> insert_or_assign(const K& k, M&& v) {
        size_t i = this->slot_for(k);
        if (this->hit(i, k)) {
            this->nodes_[i]->second = std::forward<M>(v);
            return {this->nth(i), false};
        }
        this->nodes_.insert(this->nodes_.begin() + i, new value_type(k, std::forward<M>(v)));
        return {this->nth(i), true};
    }
    template <class... A>
    pair<iterator, bool> try_emplace(const K& k, A&&... a) {
        size_t i = this->slot_for(k);
        if (this->hit(i, k)) return {this->nth(i), false};
        this->nodes_.insert(this->nodes_.begin() + i, new value_type(k, V(std::forward<A>(a)...)));
        return {this->nth(i), true};
    }
};

template <class K, class V, class H = void, class E = void>
using unordered_map = map<K, V>;

}
