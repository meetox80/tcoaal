#pragma once
#include_next <cctype>

namespace std {

inline int isalnum(int c) { return isalpha(c) || isdigit(c); }
inline int isupper(int c) { return c >= 'A' && c <= 'Z'; }
inline int islower(int c) { return c >= 'a' && c <= 'z'; }
inline int isxdigit(int c) { return isdigit(c) || ((c | 32) >= 'a' && (c | 32) <= 'f'); }

}
